{
    "name": "webqamdev/activity-logger",
    "description": "Log every model creation, edition and deletion.",
    "authors": [
        {
            "name": "Robin DESORME",
            "email": "rdesorme@webqam.fr",
            "role": "Maintainer"
        },
        {
            "name": "Jérémy ARGOUD",
            "email": "jargoud@webqam.fr",
            "role": "Maintainer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/support": "^12.0 || ^13.0",
        "spatie/laravel-activitylog": "^5.0"
    },
    "require-dev": {
      "laravel/pint": "^1.29"
    },
    "autoload": {
        "psr-4": {
            "Webqamdev\\ActivityLogger\\": "src"
        }
    },
    "extra": {
        "laravel": {
